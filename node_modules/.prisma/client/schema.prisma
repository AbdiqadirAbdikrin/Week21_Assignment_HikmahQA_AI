// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Translation {
  id             String   @id @default(cuid())
  text           String
  translatedText String
  fromLang       String
  toLang         String
  createdAt      DateTime @default(now())

  @@map("translations")
}
